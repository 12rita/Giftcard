{
    "compilerOptions": {
        "outDir": "./dist/",
        "sourceMap": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "noImplicitAny": false,
        "module": "commonjs",
        "target": "es5",
        "jsx": "react",
        "moduleResolution": "node",
        "strict": false,
        "allowJs": true,
        "lib": ["es6", "es7", "dom", "es2020.promise"],
        "allowSyntheticDefaultImports": true,
        "experimentalDecorators": true,
        "baseUrl": ".",
        "noImplicitUseStrict": false,
        "paths": {
            "*": ["*"]
        },
        "skipLibCheck": true,
        "types": ["react", "node"]
    },
    "exclude": [
        "node_modules",
        "dist"
    ],
    "include": ["./src/**/*"]
}
